# QRonos · variables de entorno (copiar como .env en la raíz y completar)
PORT=3000
HOST=127.0.0.1
BASE_PATH=/qronos

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qronos_app
DB_PASSWORD=CAMBIAR_CLAVE_SEGURA
DB_NAME=qronos

# Segundos en que una segunda lectura del mismo RUT se ignora
ANTI_REBOTE=15

# QR dinámico: clave de firma (openssl rand -hex 32) y vigencia en segundos
QR_SECRETO=
QR_VIGENCIA=60

# Inicio de sesión de la intranet (OpenID Connect)
OIDC_ISSUER=https://login.intranet.institucion.cl
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://qronos.intranet.institucion.cl/qronos/auth/callback
OIDC_CLAIM_RUT=rut

# Sincronización con Matrícula y RR.HH.
SYNC_HORA=06:00
MATRICULA_API_URL=
RRHH_API_URL=

# Días que se guardan los registros de acceso
RETENCION_DIAS=365
